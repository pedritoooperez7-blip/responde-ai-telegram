* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--tg-theme-bg-color, #111827);
  color: var(--tg-theme-text-color, #ffffff);
}

.app {
  width: min(100%, 520px);
  min-height: 100vh;
  margin: 0 auto;
  padding: 32px 22px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.brand {
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 3px;
  margin-bottom: 28px;
  opacity: 0.8;
}

h1 {
  margin: 0 0 14px;
  font-size: 30px;
  line-height: 1.15;
}

p {
  max-width: 380px;
  margin: 0 0 28px;
  line-height: 1.5;
  opacity: 0.75;
}

button {
  border: 0;
  border-radius: 12px;
  padding: 14px 28px;
  font-size: 16px;
  font-weight: 700;
  color: var(--tg-theme-button-text-color, #ffffff);
  background: var(--tg-theme-button-color, #2481cc);
}

button:active {
  transform: scale(0.98);
}

#status {
  margin-top: 24px;
  font-size: 14px;
  opacity: 0.7;
}

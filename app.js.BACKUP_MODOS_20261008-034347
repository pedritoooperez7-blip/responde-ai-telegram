function pointerPos(ev){const r=$('#cropViewport').getBoundingClientRect();return{x:(ev.clientX-r.left)/r.width,y:(ev.clientY-r.top)/r.height}}
function beginCrop(ev){ev.preventDefault();const p=pointerPos(ev),x=p.x,y=p.y,b=crop.box;const hs=.045;let resize=null;if(Math.abs(x-b.x)<hs&&Math.abs(y-b.y)<hs)resize='tl';else if(Math.abs(x-(b.x+b.w))<hs&&Math.abs(y-b.y)<hs)resize='tr';else if(Math.abs(x-b.x)<hs&&Math.abs(y-(b.y+b.h))<hs)resize='bl';else if(Math.abs(x-(b.x+b.w))<hs&&Math.abs(y-(b.y+b.h))<hs)resize='br';crop.drag=!resize;crop.resize=resize;crop.sx=x;crop.sy=y;crop.start={...b}}
function moveCrop(ev){if(!crop.drag&&!crop.resize)return;const p=pointerPos(ev),dx=p.x-crop.sx,dy=p.y-crop.sy,b={...crop.start};if(crop.drag){b.x=Math.max(0,Math.min(1-b.w,b.x+dx));b.y=Math.max(0,Math.min(1-b.h,b.y+dy))}


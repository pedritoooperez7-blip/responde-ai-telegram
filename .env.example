# Copia estas variables en Railway (Variables). No subas valores reales al repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=        # >=32 caracteres aleatorios
TELEGRAM_MINI_APP_URL=https://TU-APP.up.railway.app
PUBLIC_BASE_URL=https://TU-APP.up.railway.app
SESSION_SECRET=                 # >=32 caracteres
ADMIN_KEY=                      # >=32 caracteres
AI_PROVIDER_ENCRYPTION_KEY=     # >=32 caracteres
GEMINI_API_KEY=                 # al menos un proveedor de IA
DB_PATH=/base/liggacuba.db      # volumen persistente (usuarios, Premium, fotos de citas)
CORS_ORIGINS=https://TU-APP.up.railway.app
BANDEC_ACCOUNT=
BPA_ACCOUNT=
PAYMENT_PHONE=
ATAJO_KEY=
PAYMENT_ARCHIVE_CHAT_ID=        # chat privado de comprobantes
ADMIN_TELEGRAM_IDS=

# Backup automatico de la base de datos a Telegram (nuevo)
BACKUP_CHAT_ID=                 # opcional: si esta vacio usa PAYMENT_ARCHIVE_CHAT_ID
BACKUP_ENCRYPTION_KEY=          # recomendado (>=32 caracteres). Sin ella el backup va sin cifrar
BACKUP_INTERVAL_HOURS=6         # opcional (minimo 0.25)
# DISABLE_TELEGRAM_BACKUP=1     # desactiva el backup

# Precios de los planes de anuncio para negocios (CUP). Si no se definen, se usan estos valores.
AD_PRICE_DAILY=750
AD_PRICE_WEEKLY=4500
AD_PRICE_MONTHLY=9000
AD_PRICE_ANNUAL=17500

# Fotos de Citas en Tigris Object Storage (opcional; sin estas 4 variables se guardan en el disco como antes)
# Tier gratuito: 5 GB permanentes, sin tarjeta de credito, egreso gratis
# Registro en: https://console.storage.dev
B2_ENDPOINT=https://t3.storage.dev
B2_ACCESS_KEY=
B2_SECRET_KEY=
B2_BUCKET=liggacuba-fotos2026

# Limpieza automatica de usuarios (valores por defecto; todos opcionales)
# AUTO_CLEANUP_USERS=1            # 0 desactiva toda la limpieza de usuarios
# CLEANUP_DRY_RUN=1               # solo registra en logs lo que borraria, sin borrar nada (recomendado el primer dia)
# INACTIVE_USER_DAYS=30           # dias sin usar la app (sin Premium) para borrar al usuario
# GHOST_USER_DAYS=7               # dias para borrar cuentas que nunca usaron la app
# BAN_GRACE_HOURS=48              # horas que se conservan los datos de un usuario baneado
# PENDING_PAYMENT_DAYS=3          # dias para cancelar pagos sin comprobante
# USAGE_LOG_RETENTION_DAYS=0      # 0 = no borrar (por defecto). Si lo activas, los contadores del perfil bajan
# CLEANUP_MAX_USERS_PER_RUN=200   # tope de usuarios borrados por ciclo (cada 6 h)
